{
  "manifest_version": 3,
  "name": "AnyAnnotate - Web Highlights & Notes",
  "version": "0.6.4",
  "minimum_chrome_version": "109",
  "description": "Highlight web text, add annotations, and save to Google Docs, Markdown, plain text, or a local inbox.",
  "permissions": [
    "downloads",
    "storage",
    "identity"
  ],
  "oauth2": {
    "client_id": "664499921933-uqk0om0t4hb0ps9b95pu9g76l8p8pngo.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/documents"]
  },
  "host_permissions": ["https://docs.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AnyAnnotate",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
