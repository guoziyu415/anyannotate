{
  "name": "anyannotate-mcp-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Interactive MCP App for collecting and annotating answer excerpts.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run typecheck && vite build",
    "dev": "tsx watch server/index.ts",
    "start": "npm run build --silent && tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.5.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
